# The pure replay reader needs only Nim's JavaScript compiler and standard library.
FROM nimlang/nim:2.2.4 AS replay-viewer-builder
WORKDIR /workspace/parley
COPY src/parley ./src/parley
COPY replay-viewer/parley_replay.nim ./replay-viewer/parley_replay.nim
RUN nim js -d:release --hints:off --path:src \
    --out:replay-viewer/dist/parley_replay.js replay-viewer/parley_replay.nim
