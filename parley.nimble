version     = "0.1.0"
author      = "daveey"
description = "Parley: LLM-driven table-shooting party game. N cogs around a table; \"it\" talks, then shoots; the shot cog takes 1 damage and becomes \"it\"; last cog standing wins."
license     = "MIT"

srcDir = "src"

requires "nim >= 2.2.4"
requires "bitworld >= 0.1.0"
requires "mummy >= 0.4.7"
requires "curly >= 1.1.1"
requires "whisky"
